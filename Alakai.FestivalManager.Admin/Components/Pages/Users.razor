@page "/users"
@using System.Text
@inject UserApiClient UserApiClient
@inject RegistrationApiClient RegistrationApiClient
@inject EditionApiClient EditionApiClient
@inject FestivalApiClient FestivalApiClient

<PageHeader Title="Operations" pTitle="Users"></PageHeader>

<div class="flex flex-col gap-4 min-h-[calc(100vh-212px)]">
    <div class="grid grid-cols-1 gap-4">
        <div class="card">
            <div class="flex flex-col gap-4 mb-5 xl:flex-row xl:items-center xl:justify-between">
                <div class="flex flex-col gap-3 md:flex-row md:items-center">
                    <input class="form-input md:w-72" placeholder="Search users..." @bind="searchText" @bind:event="oninput" @bind:after="ResetPage" />

                    <select class="form-select md:w-48" @bind="festivalFilter" @bind:after="ResetPage">
                        <option value="@Guid.Empty">All festivals</option>
                        @foreach (FestivalDto f in festivals)
                        {
                            <option value="@f.Id">@f.Name</option>
                        }
                    </select>

                    <select class="form-select md:w-40" @bind="statusFilter" @bind:after="ResetPage">
                        <option value="">All statuses</option>
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                        <option value="mustchange">Must change password</option>
                    </select>

                    <select class="form-select md:w-32" @bind="pageSize" @bind:after="ResetPage">
                        <option value="50">50 rows</option>
                        <option value="100">100 rows</option>
                        <option value="500">500 rows</option>
                    </select>

                    <button type="button" class="transition-all duration-300 border rounded-md btn text-purple border-purple hover:bg-purple hover:text-white whitespace-nowrap" @onclick="OpenCreateModal">
                        <i class="ri-add-line ltr:mr-1 rtl:ml-1"></i>
                        New User
                    </button>

                    <button type="button" class="transition-all duration-300 border rounded-md btn text-purple border-purple hover:bg-purple hover:text-white whitespace-nowrap" @onclick="OpenImportModal">
                        <i class="ri-upload-2-line ltr:mr-1 rtl:ml-1"></i>
                        Import CSV
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="p-3 mb-4 text-sm rounded bg-success/10 text-success">@successMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="p-3 mb-4 text-sm rounded bg-danger/10 text-danger">@errorMessage</div>
            }

            @if (isLoading)
            {
                <p class="text-sm text-black/50 dark:text-white/60">Loading users...</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full table-hover">
                        <thead class="bg-gray-50 dark:bg-dark">
                            <tr class="text-left">
                                <th class="px-3 py-3 font-semibold"><button type="button" class="flex items-center gap-1 w-full font-semibold" @onclick='() => SortBy("Name")'>Name @SortIcon("Name")</button></th>
                                <th class="px-3 py-3 font-semibold"><button type="button" class="flex items-center gap-1 w-full font-semibold" @onclick='() => SortBy("Email")'>Email @SortIcon("Email")</button></th>
                                <th class="px-3 py-3 font-semibold">Phone</th>
                                <th class="px-3 py-3 font-semibold"><button type="button" class="flex items-center gap-1 w-full font-semibold" @onclick='() => SortBy("Country")'>Country @SortIcon("Country")</button></th>
                                <th class="px-3 py-3 font-semibold">City</th>
                                <th class="px-3 py-3 font-semibold"><button type="button" class="flex items-center gap-1 w-full font-semibold" @onclick='() => SortBy("CreatedAt")'>Created @SortIcon("CreatedAt")</button></th>
                                <th class="px-3 py-3 font-semibold">Document</th>
                                <th class="px-3 py-3 font-semibold"><button type="button" class="flex items-center gap-1 w-full font-semibold" @onclick='() => SortBy("Status")'>Status @SortIcon("Status")</button></th>
                                <th class="px-3 py-3 font-semibold text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="text-black dark:text-white/80">
                            @if (PagedUsers.Count == 0)
                            {
                                <tr>
                                    <td colspan="9" class="px-4 py-6 text-center text-black/50 dark:text-white/60">No users found.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (UserDto user in PagedUsers)
                                {
                                    <tr class="border-b border-black/10 dark:border-darkborder">
                                        <td class="px-4 py-3 max-w-[160px]">
                                            <div class="font-medium truncate">@user.FullName</div>
                                            @if (user.MustChangePassword)
                                            {
                                                <div class="text-xs text-warning">Must change password</div>
                                            }
                                        </td>
                                        <td class="px-3 py-3 max-w-[180px] truncate">@user.Email</td>
                                        <td class="px-3 py-3">@user.Phone</td>
                                        <td class="px-3 py-3">@user.Country</td>
                                        <td class="px-3 py-3">@user.City</td>
                                        <td class="px-3 py-3">@FormatDate(user.CreatedAt)</td>
                                        <td class="px-3 py-3">@GetDocumentFromRegistration(user.Id)</td>
                                        <td class="px-3 py-3"><span class="@GetStatusClass(user.IsActive)">@(user.IsActive ? "Active" : "Inactive")</span></td>
                                        <td class="px-3 py-3">
                                            <div class="flex items-center justify-end gap-2">
                                                <button type="button" class="text-black dark:text-white/80" title="Edit" @onclick="() => OpenEditModal(user)"><i class="ri-pencil-line text-lg"></i></button>
                                                <button type="button" class="text-danger" title="Delete" @onclick="() => OpenDeleteModal(user)"><i class="ri-delete-bin-line text-lg"></i></button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="flex items-center justify-between mt-4">
                    <p class="text-sm text-black/50 dark:text-white/60">Showing @StartRow to @EndRow of @FilteredUsers.Count users</p>

                    <div class="flex items-center gap-2">
                        <button type="button" class="px-4 py-2 text-sm border rounded-md border-black/10 disabled:opacity-50" disabled="@(currentPage == 1)" @onclick="PreviousPage">Previous</button>
                        <span class="flex items-center justify-center w-10 h-10 text-sm rounded-md bg-purple/10 text-purple">@currentPage</span>
                        <button type="button" class="px-4 py-2 text-sm border rounded-md border-black/10 disabled:opacity-50" disabled="@(currentPage >= TotalPages)" @onclick="NextPage">Next</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (showModal)
{
    <div class="fixed inset-0 bg-black/60 z-[999] overflow-y-auto">
        <div class="flex items-start justify-center min-h-screen px-4 py-10">
            <div class="relative mx-auto overflow-hidden bg-white border rounded-lg shadow-3xl border-black/10 dark:bg-darklight dark:border-darkborder" style="width: min(95vw, 760px);">
                <div class="flex items-center justify-between px-5 py-3 border-b border-black/10 dark:border-darkborder">
                    <h3 class="text-lg font-semibold text-black dark:text-white">@(editingUser is null ? "New User" : "Edit User")</h3>
                    <button type="button" class="text-black/50 hover:text-black dark:text-white/60" @onclick="CloseModal"><i class="ri-close-line text-2xl"></i></button>
                </div>

                <EditForm Model="formModel" OnValidSubmit="SaveAsync">
                    <div class="p-5 space-y-4">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm text-black/60 dark:text-white/60">First Name</label>
                                <InputText class="form-input" @bind-Value="formModel.FirstName" />
                            </div>

                            <div>
                                <label class="block text-sm text-black/60 dark:text-white/60">Last Name</label>
                                <InputText class="form-input" @bind-Value="formModel.LastName" />
                            </div>

                            <div>
                                <label class="block text-sm text-black/60 dark:text-white/60">Email</label>
                                <InputText class="form-input" @bind-Value="formModel.Email" />
                            </div>

                            <div>
                                <label class="block text-sm text-black/60 dark:text-white/60">Phone</label>
                                <InputText class="form-input" @bind-Value="formModel.Phone" />
                            </div>

                            <div>
                                <label class="block text-sm text-black/60 dark:text-white/60">Country</label>
                                <InputText class="form-input" @bind-Value="formModel.Country" />
                            </div>

                            <div>
                                <label class="block text-sm text-black/60 dark:text-white/60">City</label>
                                <InputText class="form-input" @bind-Value="formModel.City" />
                            </div>

                            @if (editingUser is null)
                            {
                                <div class="md:col-span-2">
                                    <label class="block text-sm text-black/60 dark:text-white/60">Initial Password</label>
                                    <InputText class="form-input" type="password" @bind-Value="formModel.Password" />
                                </div>
                            }

                            @if (editingUser is not null)
                            {
                                <div class="flex items-center gap-4 md:col-span-2">
                                    <label class="inline-flex items-center gap-2"><InputCheckbox @bind-Value="formModel.MustChangePassword" />Must change password</label>
                                    <label class="inline-flex items-center gap-2"><InputCheckbox @bind-Value="formModel.IsActive" />Active</label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="flex justify-end gap-3 px-5 py-4 border-t border-black/10 dark:border-darkborder">
                        <button type="button" class="px-4 py-2 text-sm border rounded-md border-black/10" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="px-4 py-2 text-sm text-white rounded-md bg-purple">Save</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (showImportModal)
{
    <div class="fixed inset-0 bg-black/60 z-[999] overflow-y-auto">
        <div class="flex items-start justify-center min-h-screen px-4 py-10">
            <div class="relative mx-auto overflow-hidden bg-white border rounded-lg shadow-3xl border-black/10 dark:bg-darklight dark:border-darkborder" style="width: min(95vw, 880px);">
                <div class="flex items-center justify-between px-5 py-3 border-b border-black/10 dark:border-darkborder">
                    <h3 class="text-lg font-semibold text-black dark:text-white">Import Users from CSV</h3>
                    <button type="button" class="text-black/50 hover:text-black dark:text-white/60" @onclick="CloseImportModal"><i class="ri-close-line text-2xl"></i></button>
                </div>

                <div class="p-5 space-y-4">
                    @if (!string.IsNullOrWhiteSpace(importError))
                    {
                        <div class="p-3 text-sm rounded bg-danger/10 text-danger">@importError</div>
                    }

                    @if (importStep == 1)
                    {
                        <p class="text-sm text-black/60 dark:text-white/60">
                            Select a CSV file exported from another system. On the next step you can match its
                            columns to the fields Alakai expects, so it doesn't matter if the headers or column
                            order are different.
                        </p>
                        <InputFile OnChange="OnImportFileSelected" accept=".csv,text/csv" />
                    }
                    else if (importStep == 2)
                    {
                        <p class="text-sm text-black/60 dark:text-white/60">
                            <strong>@importFileName</strong> &middot; @importDataRows.Count rows detected. Match each
                            column below to a field (or leave it as "Ignore"). An Email column is required.
                        </p>

                        <div class="overflow-x-auto border rounded-lg border-black/10 dark:border-darkborder">
                            <table class="w-full">
                                <thead class="bg-gray-50 dark:bg-dark">
                                    <tr class="text-left">
                                        <th class="px-3 py-2 font-semibold">CSV column</th>
                                        <th class="px-3 py-2 font-semibold">Example</th>
                                        <th class="px-3 py-2 font-semibold">Import as</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < importHeaders.Count; i++)
                                    {
                                        int columnIndex = i;
                                        <tr class="border-t border-black/10 dark:border-darkborder">
                                            <td class="px-3 py-2 font-medium">@importHeaders[columnIndex]</td>
                                            <td class="px-3 py-2 truncate max-w-[220px] text-black/50 dark:text-white/60">@GetSampleValue(columnIndex)</td>
                                            <td class="px-3 py-2">
                                                <select class="form-select" value="@importColumnMap[columnIndex]" @onchange="e => importColumnMap[columnIndex] = e.Value?.ToString() ?? string.Empty">
                                                    <option value="">-- Ignore --</option>
                                                    <option value="FirstName">First Name</option>
                                                    <option value="LastName">Last Name</option>
                                                    <option value="Email">Email</option>
                                                    <option value="Phone">Phone</option>
                                                    <option value="Country">Country</option>
                                                    <option value="City">City</option>
                                                </select>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (!HasEmailMapped)
                        {
                            <p class="text-sm text-warning">Map a column to Email to continue.</p>
                        }
                    }
                    else if (importStep == 3)
                    {
                        <p class="text-sm text-black/60 dark:text-white/60">
                            Preview of the first rows as they'll be imported (@importDataRows.Count rows in total).
                            Emails that already exist are skipped automatically -- existing users are never
                            overwritten.
                        </p>

                        <div class="overflow-x-auto border rounded-lg border-black/10 dark:border-darkborder">
                            <table class="w-full">
                                <thead class="bg-gray-50 dark:bg-dark">
                                    <tr class="text-left">
                                        <th class="px-3 py-2 font-semibold">First Name</th>
                                        <th class="px-3 py-2 font-semibold">Last Name</th>
                                        <th class="px-3 py-2 font-semibold">Email</th>
                                        <th class="px-3 py-2 font-semibold">Phone</th>
                                        <th class="px-3 py-2 font-semibold">Country</th>
                                        <th class="px-3 py-2 font-semibold">City</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (BulkImportUserRowRequest row in BuildMappedRows().Take(10))
                                    {
                                        <tr class="border-t border-black/10 dark:border-darkborder">
                                            <td class="px-3 py-2">@row.FirstName</td>
                                            <td class="px-3 py-2">@row.LastName</td>
                                            <td class="px-3 py-2">@row.Email</td>
                                            <td class="px-3 py-2">@row.Phone</td>
                                            <td class="px-3 py-2">@row.Country</td>
                                            <td class="px-3 py-2">@row.City</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (importStep == 4 && importResult is not null)
                    {
                        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                            <div class="p-4 border rounded-lg border-black/10 dark:border-darkborder">
                                <p class="text-2xl font-semibold text-success">@importResult.Created</p>
                                <p class="text-sm text-black/60 dark:text-white/60">Users created</p>
                            </div>
                            <div class="p-4 border rounded-lg border-black/10 dark:border-darkborder">
                                <p class="text-2xl font-semibold text-warning">@importResult.SkippedDuplicateEmails.Count</p>
                                <p class="text-sm text-black/60 dark:text-white/60">Skipped (already existed)</p>
                            </div>
                            <div class="p-4 border rounded-lg border-black/10 dark:border-darkborder">
                                <p class="text-2xl font-semibold text-danger">@importResult.Errors.Count</p>
                                <p class="text-sm text-black/60 dark:text-white/60">Rows with errors</p>
                            </div>
                        </div>

                        @if (importResult.Errors.Count > 0)
                        {
                            <div class="overflow-y-auto border rounded-lg max-h-48 border-black/10 dark:border-darkborder">
                                <table class="w-full">
                                    <thead class="bg-gray-50 dark:bg-dark">
                                        <tr class="text-left">
                                            <th class="px-3 py-2 font-semibold">Row</th>
                                            <th class="px-3 py-2 font-semibold">Email</th>
                                            <th class="px-3 py-2 font-semibold">Reason</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (BulkImportRowErrorDto rowError in importResult.Errors)
                                        {
                                            <tr class="border-t border-black/10 dark:border-darkborder">
                                                <td class="px-3 py-2">@rowError.Row</td>
                                                <td class="px-3 py-2">@rowError.Email</td>
                                                <td class="px-3 py-2">@rowError.Reason</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </div>

                <div class="flex justify-between gap-3 px-5 py-4 border-t border-black/10 dark:border-darkborder">
                    <div>
                        @if (importStep == 2 || importStep == 3)
                        {
                            <button type="button" class="btn border border-black/10" @onclick="GoBack">Back</button>
                        }
                    </div>
                    <div class="flex gap-3">
                        @if (importStep == 4)
                        {
                            <button type="button" class="btn bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85]" @onclick="CloseImportModal">Close</button>
                        }
                        else
                        {
                            <button type="button" class="btn border border-black/10" @onclick="CloseImportModal">Cancel</button>

                            @if (importStep == 2)
                            {
                                <button type="button" class="btn bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85] disabled:opacity-50" disabled="@(!HasEmailMapped)" @onclick="GoToPreview">Next: Preview</button>
                            }
                            else if (importStep == 3)
                            {
                                <button type="button" class="btn bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85] disabled:opacity-50" disabled="@isImporting" @onclick="ImportAsync">@(isImporting ? "Importing..." : $"Import {importDataRows.Count} users")</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (deletingUser is not null)
{
    <div class="fixed inset-0 bg-black/60 z-[999] overflow-y-auto">
        <div class="flex items-start justify-center min-h-screen px-4 py-10">
            <div class="relative w-[92vw] md:w-[380px] overflow-hidden bg-white border rounded-lg shadow-3xl border-black/10 dark:bg-darklight dark:border-darkborder">
                <div class="px-5 py-4">
                    <h3 class="text-lg font-semibold text-black dark:text-white">Delete User</h3>
                    <p class="mt-2 text-sm text-black/60 dark:text-white/60">Delete @deletingUser.FullName?</p>
                    <p class="mt-2 text-sm text-danger">If this user has registrations, backend constraints may block the delete.</p>
                </div>

                <div class="flex justify-end gap-3 px-5 py-4 border-t border-black/10 dark:border-darkborder">
                    <button type="button" class="btn border border-black/10" disabled="@isSaving" @onclick="CloseDeleteModal">Cancel</button>
                    <button type="button" class="btn border border-danger text-danger hover:bg-danger hover:text-white disabled:opacity-50" disabled="@isSaving" @onclick="DeleteAsync">@(isSaving ? "Deleting..." : "Delete")</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<UserDto> users = [];
    private List<RegistrationDto> allRegistrations = [];
    private List<EditionDto> editions = [];
    private List<FestivalDto> festivals = [];
    private UserDto? editingUser;
    private UserDto? deletingUser;
    private UserFormModel formModel = new();
    private string searchText = string.Empty;
    private string statusFilter = string.Empty;
    private Guid festivalFilter = Guid.Empty;
    private string sortColumn = "Name";
    private bool sortAscending = true;
    private bool isLoading = true;
    private bool isSaving;
    private bool showModal;
    private string? successMessage;
    private string? errorMessage;
    private int currentPage = 1;
    private int pageSize = 50;
    private Dictionary<Guid, string> documentsByUserId = new();

    private bool showImportModal;
    private int importStep = 1;
    private string importFileName = string.Empty;
    private List<string> importHeaders = [];
    private List<string[]> importDataRows = [];
    private Dictionary<int, string> importColumnMap = new();
    private bool isImporting;
    private string? importError;
    private BulkImportUsersResultDto? importResult;

    private static readonly Dictionary<string, string[]> ImportFieldAliases = new()
    {
        ["FirstName"] = ["first name", "firstname", "nombre"],
        ["LastName"] = ["last name", "lastname", "apellidos", "apellido", "surname"],
        ["Email"] = ["email", "e-mail", "mail", "correo", "correo electronico", "correo electrónico"],
        ["Phone"] = ["phone", "telefono", "teléfono", "tel", "movil", "móvil", "celular", "whatsapp"],
        ["Country"] = ["country", "pais", "país"],
        ["City"] = ["city", "ciudad", "poblacion", "población", "localidad"]
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            users = (await UserApiClient.GetAllAsync()).ToList();
            allRegistrations = (await RegistrationApiClient.GetAllAsync()).ToList();
            editions = (await EditionApiClient.GetAllAsync()).ToList();
            festivals = (await FestivalApiClient.GetAllAsync()).ToList();
            await LoadDocumentsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDocumentsAsync()
    {
        documentsByUserId.Clear();

        foreach (UserDto user in users)
        {
            try
            {
                RegistrationDto registration = await RegistrationApiClient.GetByUserIdAsync(user.Id);
                documentsByUserId[user.Id] = registration?.DocumentNumber ?? "-";
            }
            catch (ApiClientException)
            {
                // El usuario no tiene registration asociada, o el backend devolvi� error controlado
                documentsByUserId[user.Id] = "-";
            }
        }
    }

    private string GetDocumentFromRegistration(Guid userId)
    {
        return documentsByUserId.TryGetValue(userId, out string? doc) ? doc : "-";
    }

    private List<UserDto> FilteredUsers
    {
        get
        {
            IEnumerable<UserDto> query = users;

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                query = query.Where(u => u.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase) || u.Email.Contains(searchText, StringComparison.OrdinalIgnoreCase));
            }

            if (festivalFilter != Guid.Empty)
            {
                HashSet<Guid> editionIds = editions.Where(e => e.FestivalId == festivalFilter).Select(e => e.Id).ToHashSet();
                HashSet<Guid> userIdsInFestival = allRegistrations.Where(r => editionIds.Contains(r.EditionId)).Select(r => r.UserId).ToHashSet();
                query = query.Where(u => userIdsInFestival.Contains(u.Id));
            }

            if (statusFilter == "active")
            {
                query = query.Where(u => u.IsActive);
            }
            else if (statusFilter == "inactive")
            {
                query = query.Where(u => !u.IsActive);
            }
            else if (statusFilter == "mustchange")
            {
                query = query.Where(u => u.MustChangePassword);
            }

            query = sortColumn switch
            {
                "Email" => sortAscending ? query.OrderBy(u => u.Email) : query.OrderByDescending(u => u.Email),
                "Country" => sortAscending ? query.OrderBy(u => u.Country) : query.OrderByDescending(u => u.Country),
                "CreatedAt" => sortAscending ? query.OrderBy(u => u.CreatedAt) : query.OrderByDescending(u => u.CreatedAt),
                "Status" => sortAscending ? query.OrderBy(u => u.IsActive) : query.OrderByDescending(u => u.IsActive),
                _ => sortAscending ? query.OrderBy(u => u.FullName) : query.OrderByDescending(u => u.FullName)
            };

            return query.ToList();
        }
    }

    private List<UserDto> PagedUsers => FilteredUsers.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredUsers.Count / (double)pageSize));
    private int StartRow => FilteredUsers.Count == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    private int EndRow => Math.Min(currentPage * pageSize, FilteredUsers.Count);

    private void ResetPage()
    {
        currentPage = 1;
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private MarkupString SortIcon(string column)
    {
        if (sortColumn != column)
        {
            return new MarkupString("<i class=\"ri-arrow-up-down-line text-xs opacity-40\"></i>");
        }

        return new MarkupString(sortAscending ? "<i class=\"ri-arrow-up-s-fill text-xs text-purple\"></i>" : "<i class=\"ri-arrow-down-s-fill text-xs text-purple\"></i>");
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
        }
    }

