@page "/production-zones"

@inject ProductionZoneApiClient ProductionZoneApiClient
@inject ProductionBuildingApiClient ProductionBuildingApiClient
@inject EditionApiClient EditionApiClient
@inject FestivalApiClient FestivalApiClient
@inject ActiveFestivalState ActiveFestivalState
@implements IDisposable

<PageHeader Title="Production" pTitle="Accommodation Zones"></PageHeader>

<div class="grid grid-cols-1 gap-4 min-h-[calc(100vh-212px)]">
    <div class="card">
        <div class="flex flex-col gap-4 mb-5 xl:flex-row xl:items-center xl:justify-between">

            <div class="flex flex-col gap-3 md:flex-row md:items-center">
                <input class="form-input w-full md:w-72" placeholder="Search zones..." @bind="searchText" @bind:event="oninput" @bind:after="ResetPage" />

                <select class="form-select w-full md:w-44" @bind="festivalFilter" @bind:after="OnFestivalFilterChanged">
                    <option value="">All festivals</option>
                    @foreach (FestivalDto f in festivals)
                    {
                        <option value="@f.Id">@f.Name</option>
                    }
                </select>

                <select class="form-select w-full md:w-44" @bind="editionFilter" @bind:after="OnEditionFilterChanged">
                    <option value="">All editions</option>
                    @foreach (EditionDto edition in EditionsForSelectedFestival)
                    {
                        <option value="@edition.Id">@($"{edition.Year} - {edition.Name}")</option>
                    }
                </select>

                <select class="form-select w-full md:w-44" @bind="buildingFilter" @bind:after="ResetPage">
                    <option value="">All buildings</option>
                    @foreach (ProductionAccommodationBuildingDto b in BuildingsForSelectedEdition)
                    {
                        <option value="@b.Id">@b.Name</option>
                    }
                </select>

                <select class="form-select w-full md:w-32" @bind="pageSize" @bind:after="ResetPage">
                    <option value="10">10 rows</option>
                    <option value="25">25 rows</option>
                    <option value="50">50 rows</option>
                </select>

                <button type="button" class="transition-all duration-300 border rounded-md btn text-purple border-purple hover:bg-purple hover:text-white whitespace-nowrap" @onclick="OpenCreateModal">
                    <i class="ri-add-line ltr:mr-1 rtl:ml-1"></i>
                    New Zone
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="p-3 mb-4 text-sm rounded bg-success/10 text-success">@successMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="p-3 mb-4 text-sm rounded bg-danger/10 text-danger">@errorMessage</div>
        }

        @if (isLoading)
        {
            <p class="text-sm text-black/50 dark:text-white/60">Loading zones...</p>
        }
        else
        {
            <div class="w-full max-w-full overflow-x-auto">
                <table class="w-full table-hover">
                    <thead class="bg-gray-50 dark:bg-dark">
                        <tr class="text-left">
                            <th class="px-4 py-3 font-semibold"><button type="button" class="flex items-center gap-1 w-full font-semibold" @onclick='() => SortBy("Name")'>Name @SortIcon("Name")</button></th>
                            <th class="px-4 py-3 font-semibold">Building</th>
                            <th class="px-4 py-3 font-semibold">Sort Order</th>
                            <th class="px-4 py-3 font-semibold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="text-black dark:text-white/80">
                        @if (!PagedZones.Any())
                        {
                            <tr>
                                <td colspan="4" class="px-4 py-6 text-center text-black/50 dark:text-white/60">No zones found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (ProductionAccommodationZoneDto zone in PagedZones)
                            {
                                <tr class="border-b border-black/10 dark:border-darkborder">
                                    <td class="px-4 py-3 font-medium">
                                        <NavLink href="@($"/production-accommodations?zoneId={zone.Id}")" class="text-purple hover:underline">@zone.Name</NavLink>
                                    </td>
                                    <td class="px-4 py-3">@GetBuildingName(zone.ProductionAccommodationBuildingId)</td>
                                    <td class="px-4 py-3">@zone.SortOrder</td>
                                    <td class="px-4 py-3">
                                        <div class="flex items-center justify-end gap-3">
                                            <button type="button" class="text-black dark:text-white/80" title="Edit" @onclick="() => OpenEditModal(zone)">
                                                <i class="ri-pencil-line text-lg"></i>
                                            </button>
                                            <button type="button" class="text-danger" title="Delete" @onclick="() => OpenDeleteModal(zone)">
                                                <i class="ri-delete-bin-line text-lg"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="flex items-center justify-between mt-4">
                <p class="text-sm text-black/50 dark:text-white/60">
                    Showing @StartRow to @EndRow of @FilteredZones.Count zones
                </p>

                <div class="flex items-center gap-2">
                    <button type="button" class="px-4 py-2 text-sm border rounded-md border-black/10 disabled:opacity-50" disabled="@(currentPage == 1)" @onclick="PreviousPage">Previous</button>
                    <span class="flex items-center justify-center w-10 h-10 text-sm rounded-md bg-purple/10 text-purple">@currentPage</span>
                    <button type="button" class="px-4 py-2 text-sm border rounded-md border-black/10 disabled:opacity-50" disabled="@(currentPage >= TotalPages)" @onclick="NextPage">Next</button>
                </div>
            </div>
        }
    </div>
</div>

@if (isModalOpen)
{
    <div class="fixed inset-0 bg-black/60 z-[999] overflow-y-auto">
        <div class="flex items-start justify-center min-h-screen px-4 py-10">
            <div class="relative w-full max-w-lg overflow-hidden bg-white border rounded-lg shadow-3xl border-black/10 dark:bg-darklight dark:border-darkborder">
                <div class="flex items-center justify-between px-5 py-3 border-b border-black/10 dark:border-darkborder">
                    <h3 class="text-lg font-semibold">@(editingZone is null ? "New Zone" : "Edit Zone")</h3>
                    <button type="button" @onclick="CloseModal"><i class="ri-close-line text-2xl"></i></button>
                </div>

                <EditForm Model="formModel" OnValidSubmit="SaveAsync">
                    <div class="grid grid-cols-1 gap-4 p-5 md:grid-cols-2">
                        @if (!string.IsNullOrWhiteSpace(modalErrorMessage))
                        {
                            <div class="p-3 text-sm rounded md:col-span-2 bg-danger/10 text-danger">@modalErrorMessage</div>
                        }

                        <div class="md:col-span-2">
                            <label class="form-label">Building</label>
                            <select class="form-select" @bind="formModel.ProductionAccommodationBuildingId">
                                @foreach (ProductionAccommodationBuildingDto b in buildings)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="form-label">Name</label>
                            <InputText class="form-input" @bind-Value="formModel.Name" />
                        </div>

                        <div>
                            <label class="form-label">Sort order</label>
                            <InputNumber class="form-input" @bind-Value="formModel.SortOrder" />
                        </div>
                    </div>

                    <div class="flex justify-end gap-3 px-5 py-4 border-t border-black/10 dark:border-darkborder">
                        <button type="button" class="btn border border-black/10" disabled="@isSaving" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="btn border border-purple text-purple hover:bg-purple hover:text-white disabled:opacity-50" disabled="@isSaving">@(isSaving ? "Saving..." : "Save")</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (deleteZone is not null)
{
    <div class="fixed inset-0 bg-black/60 z-[999] overflow-y-auto">
        <div class="flex items-start justify-center min-h-screen px-4 py-10">
            <div class="relative w-[92vw] md:w-[380px] overflow-hidden bg-white border rounded-lg shadow-3xl border-black/10 dark:bg-darklight dark:border-darkborder">
                <div class="px-5 py-4">
                    <h3 class="text-lg font-semibold text-black dark:text-white">Delete Zone</h3>
                    <p class="mt-2 text-sm text-black/60 dark:text-white/60">Are you sure you want to delete <strong>@deleteZone.Name</strong>?</p>
                </div>
                <div class="flex justify-end gap-3 px-5 py-4 border-t border-black/10 dark:border-darkborder">
                    <button type="button" class="btn border border-black/10" disabled="@isSaving" @onclick="CloseDeleteModal">Cancel</button>
                    <button type="button" class="btn border border-danger text-danger hover:bg-danger hover:text-white disabled:opacity-50" disabled="@isSaving" @onclick="DeleteAsync">@(isSaving ? "Deleting..." : "Delete")</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "buildingId")]
    public Guid? BuildingIdParam { get; set; }

    private List<ProductionAccommodationZoneDto> zones = [];
    private List<ProductionAccommodationBuildingDto> buildings = [];
    private List<EditionDto> editions = [];
    private List<FestivalDto> festivals = [];
    private ProductionZoneFormModel formModel = new();
    private ProductionAccommodationZoneDto? editingZone;
    private ProductionAccommodationZoneDto? deleteZone;
    private string searchText = string.Empty;
    private string festivalFilter = string.Empty;
    private string editionFilter = string.Empty;
    private string buildingFilter = string.Empty;
    private string sortColumn = "Name";
    private bool sortAscending = true;
    private bool isLoading = true;
    private bool isModalOpen;
    private bool isSaving;
    private string? successMessage;
    private string? errorMessage;
    private string? modalErrorMessage;
    private int pageSize = 10;
    private int currentPage = 1;

    private List<EditionDto> EditionsForSelectedFestival =>
        string.IsNullOrWhiteSpace(festivalFilter) || !Guid.TryParse(festivalFilter, out Guid fid)
            ? editions
            : editions.Where(e => e.FestivalId == fid).ToList();

    private List<ProductionAccommodationBuildingDto> BuildingsForSelectedEdition =>
        string.IsNullOrWhiteSpace(editionFilter) || !Guid.TryParse(editionFilter, out Guid eid)
            ? buildings
            : buildings.Where(b => b.EditionId == eid).ToList();

    protected override async Task OnInitializedAsync()
    {
        ActiveFestivalState.OnChange += HandleFestivalStateChanged;

        if (BuildingIdParam.HasValue)
        {
            buildingFilter = BuildingIdParam.Value.ToString();
        }

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            editions = (await EditionApiClient.GetAllAsync()).ToList();
            festivals = (await FestivalApiClient.GetAllAsync()).ToList();
            buildings = (await ProductionBuildingApiClient.GetAllAsync()).ToList();

            if (!BuildingIdParam.HasValue)
            {
                if (ActiveFestivalState.Active is not null && string.IsNullOrWhiteSpace(festivalFilter))
                {
                    festivalFilter = ActiveFestivalState.Active.Id.ToString();
                }

                if (ActiveFestivalState.Active is not null && string.IsNullOrWhiteSpace(editionFilter))
                {
                    EditionDto? preferred = editions.FirstOrDefault(e => e.FestivalId == ActiveFestivalState.Active.Id && e.IsActive)
                        ?? editions.FirstOrDefault(e => e.FestivalId == ActiveFestivalState.Active.Id);

                    if (preferred is not null)
                    {
                        editionFilter = preferred.Id.ToString();
                    }
                }
            }
            else
            {
                ProductionAccommodationBuildingDto? preselected = buildings.FirstOrDefault(b => b.Id == BuildingIdParam.Value);

                if (preselected is not null)
                {
                    editionFilter = preselected.EditionId.ToString();
                    EditionDto? edition = editions.FirstOrDefault(e => e.Id == preselected.EditionId);

                    if (edition is not null)
                    {
                        festivalFilter = edition.FestivalId.ToString();
                    }
                }
            }

            zones = (await ProductionZoneApiClient.GetAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnFestivalFilterChanged()
    {
        editionFilter = string.Empty;
        buildingFilter = string.Empty;
        ResetPage();
    }

    private void OnEditionFilterChanged()
    {
        buildingFilter = string.Empty;
        ResetPage();
    }

    private string GetBuildingName(Guid buildingId)
    {
        return buildings.FirstOrDefault(b => b.Id == buildingId)?.Name ?? "-";
    }

    private List<ProductionAccommodationZoneDto> FilteredZones
    {
        get
        {
            IEnumerable<ProductionAccommodationZoneDto> query = zones;

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                query = query.Where(z => z.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase));
            }

            if (Guid.TryParse(buildingFilter, out Guid buildingId))
            {
                query = query.Where(z => z.ProductionAccommodationBuildingId == buildingId);
            }
            else if (Guid.TryParse(editionFilter, out Guid editionId))
            {
                HashSet<Guid> buildingIds = buildings.Where(b => b.EditionId == editionId).Select(b => b.Id).ToHashSet();
                query = query.Where(z => buildingIds.Contains(z.ProductionAccommodationBuildingId));
            }
            else if (Guid.TryParse(festivalFilter, out Guid fid))
            {
                HashSet<Guid> editionIds = editions.Where(e => e.FestivalId == fid).Select(e => e.Id).ToHashSet();
                HashSet<Guid> buildingIds = buildings.Where(b => editionIds.Contains(b.EditionId)).Select(b => b.Id).ToHashSet();
                query = query.Where(z => buildingIds.Contains(z.ProductionAccommodationBuildingId));
            }

            query = sortAscending ? query.OrderBy(z => z.SortOrder).ThenBy(z => z.Name) : query.OrderByDescending(z => z.SortOrder).ThenByDescending(z => z.Name);

            return query.ToList();
        }
    }

    private IEnumerable<ProductionAccommodationZoneDto> PagedZones => FilteredZones.Skip((currentPage - 1) * pageSize).Take(pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredZones.Count / (double)pageSize));
    private int StartRow => FilteredZones.Count == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    private int EndRow => Math.Min(currentPage * pageSize, FilteredZones.Count);

    private void ResetPage()
    {
        currentPage = 1;
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private MarkupString SortIcon(string column)
    {
        if (sortColumn != column)
        {
            return new MarkupString("<i class=\"ri-arrow-up-down-line text-xs opacity-40\"></i>");
        }

        return new MarkupString(sortAscending ? "<i class=\"ri-arrow-up-s-fill text-xs text-purple\"></i>" : "<i class=\"ri-arrow-down-s-fill text-xs text-purple\"></i>");
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
        }
    }

    private void OpenCreateModal()
    {
        editingZone = null;
        modalErrorMessage = null;
        formModel = new ProductionZoneFormModel
        {
            ProductionAccommodationBuildingId = Guid.TryParse(buildingFilter, out Guid bid) ? bid : (buildings.FirstOrDefault()?.Id ?? Guid.Empty)
        };
        isModalOpen = true;
    }

    private void OpenEditModal(ProductionAccommodationZoneDto zone)
    {
        editingZone = zone;
        modalErrorMessage = null;
        formModel = new ProductionZoneFormModel
        {
            ProductionAccommodationBuildingId = zone.ProductionAccommodationBuildingId,
            Name = zone.Name,
            SortOrder = zone.SortOrder
        };
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
        isSaving = false;
    }

    private async Task SaveAsync()
    {
        if (isSaving) return;

        try
        {
            isSaving = true;
            modalErrorMessage = null;

            if (editingZone is null)
            {
                CreateProductionAccommodationZoneRequest request = new()
                {
                    ProductionAccommodationBuildingId = formModel.ProductionAccommodationBuildingId,
                    Name = formModel.Name,
                    SortOrder = formModel.SortOrder
                };

                await ProductionZoneApiClient.CreateAsync(request);
                ShowSuccess("Zone created successfully.");
            }
            else
            {
                UpdateProductionAccommodationZoneRequest request = new()
                {
                    ProductionAccommodationBuildingId = formModel.ProductionAccommodationBuildingId,
                    Name = formModel.Name,
                    SortOrder = formModel.SortOrder
                };

                await ProductionZoneApiClient.UpdateAsync(editingZone.Id, request);
                ShowSuccess("Zone updated successfully.");
            }

            CloseModal();
            await LoadDataAsync();
        }
        catch (ApiClientException ex)
        {
            modalErrorMessage = BuildErrorMessage(ex);
        }
        catch (Exception ex)
        {
            modalErrorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OpenDeleteModal(ProductionAccommodationZoneDto zone)
    {
        deleteZone = zone;
    }

    private void CloseDeleteModal()
    {
        deleteZone = null;
    }

    private async Task DeleteAsync()
    {
        if (deleteZone is null || isSaving) return;

        try
        {
            isSaving = true;
            await ProductionZoneApiClient.DeleteAsync(deleteZone.Id);
            deleteZone = null;
            ShowSuccess("Zone deleted successfully.");
            await LoadDataAsync();
        }
        catch (ApiClientException ex)
        {
            errorMessage = BuildErrorMessage(ex);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string BuildErrorMessage(ApiClientException exception)
    {
        if (exception.Errors.Count == 0)
        {
            return exception.Message;
        }

        return $"{exception.Message} {string.Join(" ", exception.Errors)}";
    }

    private void ShowSuccess(string message)
    {
        successMessage = message;
        errorMessage = null;
        InvokeAsync(async () =>
        {
            await Task.Delay(3500);
            successMessage = null;
            StateHasChanged();
        });
    }

    private void ShowError(string message)
    {
        errorMessage = message;
        successMessage = null;
        InvokeAsync(async () =>
        {
            await Task.Delay(3500);
            errorMessage = null;
            StateHasChanged();
        });
    }

    private class ProductionZoneFormModel
    {
        public Guid ProductionAccommodationBuildingId { get; set; }
        public string Name { get; set; } = string.Empty;
        public int SortOrder { get; set; }
    }

    private void HandleFestivalStateChanged()
    {
        InvokeAsync(async () =>
        {
            festivalFilter = string.Empty;
            editionFilter = string.Empty;
            buildingFilter = string.Empty;
            await LoadDataAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ActiveFestivalState.OnChange -= HandleFestivalStateChanged;
    }
}