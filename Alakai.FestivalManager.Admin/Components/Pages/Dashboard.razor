            object series = new[] { new { name = "Revenue", data } };
            object options = new { colors = new[] { "#7c3aed", "#0ea5e9", "#16a34a", "#f59e0b", "#ec4899", "#14b8a6", "#f97316", "#6366f1" }, height = 230, distributed = true };

            await JsRuntime.InvokeVoidAsync("financeCharts.render", "passtype-revenue-chart", "bar", series, categories, options);
        }
