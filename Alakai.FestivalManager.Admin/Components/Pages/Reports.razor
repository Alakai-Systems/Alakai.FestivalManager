@page "/reports"

@inject ReportApiClient ReportApiClient
@inject EditionApiClient EditionApiClient
@inject FestivalApiClient FestivalApiClient
@inject ActiveFestivalState ActiveFestivalState
@inject IJSRuntime JsRuntime
@inject InvoiceApiClient InvoiceApiClient

<PageHeader Title="Reports" pTitle="Downloads"></PageHeader>

<div class="grid grid-cols-1 gap-4">
    <div class="card">
        <div class="flex flex-col gap-3 md:flex-row md:items-center">
            <select class="form-select w-full md:w-56" @bind="selectedFestivalId" @bind:after="OnFestivalChangedAsync">
                @foreach (FestivalDto festival in festivals)
                {
                    <option value="@festival.Id">@festival.Name</option>
                }
            </select>
            <select class="form-select w-full md:w-64" @bind="selectedEditionId" @bind:after="OnEditionChangedAsync">
                @foreach (EditionDto edition in editionsForSelectedFestival)
                {
                    <option value="@edition.Id">@edition.Name</option>
                }
            </select>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="p-3 text-sm rounded bg-success/10 text-success">@successMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="p-3 text-sm rounded bg-danger/10 text-danger">@errorMessage</div>
    }

    <div class="card">
        <div class="inline-flex items-center gap-1 p-1 mb-4 rounded-lg bg-black/5 dark:bg-white/5 w-fit" role="tablist">
            <button type="button" role="tab" aria-selected="@(activeTab == "operations" ? "true" : "false")" class="px-4 py-2 text-sm font-semibold rounded-md transition-colors @(activeTab == "operations" ? "bg-white dark:bg-dark text-purple shadow-sm" : "text-black/50 dark:text-white/50 hover:text-black dark:hover:text-white")" @onclick='() => activeTab = "operations"'>
                Operations
            </button>
            <button type="button" role="tab" aria-selected="@(activeTab == "finance" ? "true" : "false")" class="px-4 py-2 text-sm font-semibold rounded-md transition-colors @(activeTab == "finance" ? "bg-white dark:bg-dark text-purple shadow-sm" : "text-black/50 dark:text-white/50 hover:text-black dark:hover:text-white")" @onclick='() => activeTab = "finance"'>
                Finance
            </button>
        </div>

        @if (selectedEditionId == Guid.Empty)
        {
            <p class="text-sm text-black/50 dark:text-white/60">Select a festival and edition above.</p>
        }
        else if (activeTab == "operations")
        {
            <div class="overflow-x-auto">
                <table class="w-full table-hover">
                    <thead class="bg-gray-50 dark:bg-dark">
                        <tr class="text-left">
                            <th class="px-4 py-3 font-semibold">Report</th>
                            <th class="px-4 py-3 font-semibold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="text-black dark:text-white/80">
                        <tr class="border-b border-black/10 dark:border-darkborder">
                            <td class="px-4 py-3">Users</td>
                            <td class="px-4 py-3 text-right">
                                <button type="button" class="btn bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85] disabled:opacity-50" disabled="@(downloadingReport == "users")" @onclick='() => DownloadAsync("users")'>
                                    <i class="ri-download-line ltr:mr-1 rtl:ml-1"></i>@(downloadingReport == "users" ? "Downloading..." : "Download")
                                </button>
                            </td>
                        </tr>
                        <tr class="border-b border-black/10 dark:border-darkborder">
                            <td class="px-4 py-3">Registrations</td>
                            <td class="px-4 py-3 text-right">
                                <button type="button" class="btn bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85] disabled:opacity-50" disabled="@(downloadingReport == "registrations")" @onclick='() => DownloadAsync("registrations")'>
                                    <i class="ri-download-line ltr:mr-1 rtl:ml-1"></i>@(downloadingReport == "registrations" ? "Downloading..." : "Download")
                                </button>
                            </td>
                        </tr>
                        <tr class="border-b border-black/10 dark:border-darkborder">
                            <td class="px-4 py-3">Check-in</td>
                            <td class="px-4 py-3 text-right">
                                <button type="button" class="btn bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85] disabled:opacity-50" disabled="@(downloadingReport == "checkin")" @onclick='() => DownloadAsync("checkin")'>
                                    <i class="ri-download-line ltr:mr-1 rtl:ml-1"></i>@(downloadingReport == "checkin" ? "Downloading..." : "Download")
                                </button>
                            </td>
                        </tr>
                        <tr class="border-b border-black/10 dark:border-darkborder">
                            <td class="px-4 py-3">Competitions</td>
                            <td class="px-4 py-3 text-right">
                                <button type="button" class="btn bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85] disabled:opacity-50" disabled="@(downloadingReport == "competitions")" @onclick='() => DownloadAsync("competitions")'>
                                    <i class="ri-download-line ltr:mr-1 rtl:ml-1"></i>@(downloadingReport == "competitions" ? "Downloading..." : "Download")
                                </button>
                            </td>
                        </tr>
                        @if (HasAccommodationModule)
                        {
                            <tr class="border-b border-black/10 dark:border-darkborder">
                                <td class="px-4 py-3">Accommodation</td>
                                <td class="px-4 py-3 text-right">
                                    <button type="button" class="btn bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85] disabled:opacity-50" disabled="@(downloadingReport == "accommodation")" @onclick='() => DownloadAsync("accommodation")'>
                                        <i class="ri-download-line ltr:mr-1 rtl:ml-1"></i>@(downloadingReport == "accommodation" ? "Downloading..." : "Download")
                                    </button>
                                </td>
                            </tr>
                            <tr class="border-b border-black/10 dark:border-darkborder">
                                <td class="px-4 py-3">
                                    Accommodation (Floor Plan)
                                </td>
                                <td class="px-4 py-3 text-right">
                                    <button type="button" class="btn bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85] disabled:opacity-50" disabled="@(downloadingReport == "accommodation-grid")" @onclick='() => DownloadAsync("accommodation-grid")'>
                                        <i class="ri-download-line ltr:mr-1 rtl:ml-1"></i>@(downloadingReport == "accommodation-grid" ? "Downloading..." : "Download")
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (HasTransportModule)
                        {
                            <tr class="border-b border-black/10 dark:border-darkborder">
                                <td class="px-4 py-3">Buses</td>
                                <td class="px-4 py-3 text-right">
                                    <button type="button" class="btn bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85] disabled:opacity-50" disabled="@(downloadingReport == "buses")" @onclick='() => DownloadAsync("buses")'>
                                        <i class="ri-download-line ltr:mr-1 rtl:ml-1"></i>@(downloadingReport == "buses" ? "Downloading..." : "Download")
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (HasMealsModule)
                        {
                            <tr class="border-b border-black/10 dark:border-darkborder">
                                <td class="px-4 py-3">Meals</td>
                                <td class="px-4 py-3 text-right">
                                    <button type="button" class="btn bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85] disabled:opacity-50" disabled="@(downloadingReport == "meals")" @onclick='() => DownloadAsync("meals")'>
                                        <i class="ri-download-line ltr:mr-1 rtl:ml-1"></i>@(downloadingReport == "meals" ? "Downloading..." : "Download")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full table-hover">
                    <thead class="bg-gray-50 dark:bg-dark">
                        <tr class="text-left">
                            <th class="px-4 py-3 font-semibold">Report</th>
                            <th class="px-4 py-3 font-semibold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="text-black dark:text-white/80">
                        <tr class="border-b border-black/10 dark:border-darkborder">
                            <td class="px-4 py-3">Payments Detail</td>
                            <td class="px-4 py-3 text-right">
                                <button type="button" class="btn bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85] disabled:opacity-50" disabled="@(downloadingReport == "finance-payments")" @onclick='() => DownloadAsync("finance-payments")'>
                                    <i class="ri-download-line ltr:mr-1 rtl:ml-1"></i>@(downloadingReport == "finance-payments" ? "Downloading..." : "Download")
                                </button>
                            </td>
                        </tr>
                        <tr class="border-b border-black/10 dark:border-darkborder">
                            <td class="px-4 py-3">Outstanding Balances</td>
                            <td class="px-4 py-3 text-right">
                                <button type="button" class="btn bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85] disabled:opacity-50" disabled="@(downloadingReport == "outstanding-balances")" @onclick='() => DownloadAsync("outstanding-balances")'>
                                    <i class="ri-download-line ltr:mr-1 rtl:ml-1"></i>@(downloadingReport == "outstanding-balances" ? "Downloading..." : "Download")
                                </button>
                            </td>
                        </tr>
                        <tr class="border-b border-black/10 dark:border-darkborder">
                            <td class="px-4 py-3">Invoices / VAT</td>
                            <td class="px-4 py-3 text-right">
                                <button type="button" class="btn bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85] disabled:opacity-50" disabled="@(downloadingReport == "invoices")" @onclick='() => DownloadAsync("invoices")'>
                                    <i class="ri-download-line ltr:mr-1 rtl:ml-1"></i>@(downloadingReport == "invoices" ? "Downloading..." : "Download")
                                </button>
                            </td>
                        </tr>
                        <tr class="border-b border-black/10 dark:border-darkborder">
                            <td class="px-4 py-3">Invoice PDFs</td>
                            <td class="px-4 py-3 text-right">
                                <button type="button" class="btn bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85] disabled:opacity-50" disabled="@(downloadingReport == "invoice-pdfs")" @onclick="DownloadInvoicesZipAsync">
                                    <i class="ri-download-line ltr:mr-1 rtl:ml-1"></i>@(downloadingReport == "invoice-pdfs" ? "Downloading..." : "Download")
                                </button>
                            </td>
                        </tr>
                        <tr class="border-b border-black/10 dark:border-darkborder">
                            <td class="px-4 py-3">Generate Invoices</td>
                            <td class="px-4 py-3 text-right">
                                <button type="button" class="btn bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85] disabled:opacity-50" disabled="@(downloadingReport == "invoice-pdfs-generate")" @onclick="OpenBulkCreateInvoicesModal">
                                    <i class="ri-file-add-line ltr:mr-1 rtl:ml-1"></i>@(downloadingReport == "invoice-pdfs-generate" ? "Generating..." : "Generate & Download")
                                </button>
                            </td>
                        </tr>
                        <tr class="border-b border-black/10 dark:border-darkborder">
                            <td class="px-4 py-3">Financial Summary</td>
                            <td class="px-4 py-3 text-right">
                                <button type="button" class="btn bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85] disabled:opacity-50" disabled="@(downloadingReport == "financial-summary")" @onclick='() => DownloadAsync("financial-summary")'>
                                    <i class="ri-download-line ltr:mr-1 rtl:ml-1"></i>@(downloadingReport == "financial-summary" ? "Downloading..." : "Download")
                                </button>
                            </td>
                        </tr>
                        <tr class="border-b border-black/10 dark:border-darkborder">
                            <td class="px-4 py-3">Early Bird vs Regular</td>
                            <td class="px-4 py-3 text-right">
                                <button type="button" class="btn bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85] disabled:opacity-50" disabled="@(downloadingReport == "early-bird")" @onclick='() => DownloadAsync("early-bird")'>
                                    <i class="ri-download-line ltr:mr-1 rtl:ml-1"></i>@(downloadingReport == "early-bird" ? "Downloading..." : "Download")
                                </button>
                            </td>
                        </tr>
                        <tr class="border-b border-black/10 dark:border-darkborder">
                            <td class="px-4 py-3">Refunds &amp; Cancellations</td>
                            <td class="px-4 py-3 text-right">
                                <button type="button" class="btn bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85] disabled:opacity-50" disabled="@(downloadingReport == "refunds")" @onclick='() => DownloadAsync("refunds")'>
                                    <i class="ri-download-line ltr:mr-1 rtl:ml-1"></i>@(downloadingReport == "refunds" ? "Downloading..." : "Download")
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (showBulkCreateInvoicesModal)
{
    <div class="fixed inset-0 bg-black/60 z-[999] overflow-y-auto">
        <div class="flex items-start justify-center min-h-screen px-4 py-10">
            <div class="relative confirm-modal-380 overflow-hidden bg-white border rounded-lg shadow-3xl border-black/10 dark:bg-darklight dark:border-darkborder">
                <div class="px-5 py-4">
                    <h3 class="text-lg font-semibold text-black dark:text-white">Generate Invoices</h3>
                    <p class="mt-2 text-sm text-black/60 dark:text-white/60">
                        This generates an invoice for every paid registration in this edition that doesn't have one yet, using the data already on file for each attendee (name, document, city, country -- no fiscal address, since the registration form never asks for one). This is for internal accounting, not fiscal invoices for attendees. It can only be done once per registration: it won't recreate invoices that already exist. Continue?
                    </p>
                </div>
                <div class="flex justify-end gap-3 px-5 py-4 border-t border-black/10 dark:border-darkborder">
                    <button type="button" class="btn border border-black/10" disabled="@(downloadingReport == "invoice-pdfs-generate")" @onclick="CloseBulkCreateInvoicesModal">Cancel</button>
                    <button type="button" class="btn bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85] disabled:opacity-50" disabled="@(downloadingReport == "invoice-pdfs-generate")" @onclick="ConfirmBulkCreateInvoicesAsync">@(downloadingReport == "invoice-pdfs-generate" ? "Generating..." : "Generate & Download")</button>
                </div>
            </div>
        </div>
    </div>
}

<script>
    window.downloadFileFromBase64 = (filename, base64, mimeType) => {
        const byteCharacters = atob(base64);
        const byteNumbers = new Array(byteCharacters.length);
        for (let i = 0; i < byteCharacters.length; i++) {
            byteNumbers[i] = byteCharacters.charCodeAt(i);
        }
        const byteArray = new Uint8Array(byteNumbers);
        const blob = new Blob([byteArray], { type: mimeType });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    };
</script>

@implements IDisposable
@code {
    private List<FestivalDto> festivals = [];
    private List<EditionDto> editions = [];
    private Guid selectedFestivalId;
    private Guid selectedEditionId;
    private string activeTab = "operations";
    private string? downloadingReport;
    private string? successMessage;
    private string? errorMessage;
    private bool showBulkCreateInvoicesModal;

    private List<EditionDto> editionsForSelectedFestival =>
        editions.Where(e => e.FestivalId == selectedFestivalId).OrderByDescending(e => e.Year).ToList();

    // Module flags are checked against the festival selected on THIS page, not the
    // global ActiveFestivalState -- changing the filter here must never affect other
    // pages or the Sidebar.
    private FestivalDto? SelectedFestival => festivals.FirstOrDefault(f => f.Id == selectedFestivalId);
    private bool HasAccommodationModule => SelectedFestival is not null && (SelectedFestival.EnabledModules & 2) != 0;
    private bool HasTransportModule => SelectedFestival is not null && (SelectedFestival.EnabledModules & 4) != 0;
    private bool HasMealsModule => SelectedFestival is not null && (SelectedFestival.EnabledModules & 8) != 0;

    protected override async Task OnInitializedAsync()
    {
        ActiveFestivalState.OnChange += HandleFestivalStateChanged;

        try
        {
            festivals = (await FestivalApiClient.GetAllAsync()).Where(f => f.IsActive).ToList();
            editions = (await EditionApiClient.GetAllAsync()).ToList();

            FestivalDto? preferredFestival = ActiveFestivalState.Active is not null
                ? festivals.FirstOrDefault(f => f.Id == ActiveFestivalState.Active.Id)
                : null;

            selectedFestivalId = preferredFestival?.Id
                ?? editions.FirstOrDefault(e => e.IsActive)?.FestivalId
                ?? festivals.FirstOrDefault()?.Id
                ?? Guid.Empty;

            EditionDto? preferredEdition = editionsForSelectedFestival.FirstOrDefault(e => e.IsActive)
                ?? editionsForSelectedFestival.FirstOrDefault();

            selectedEditionId = preferredEdition?.Id ?? Guid.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void OnFestivalChangedAsync()
    {
        EditionDto? preferredEdition = editionsForSelectedFestival.FirstOrDefault(e => e.IsActive)
            ?? editionsForSelectedFestival.FirstOrDefault();

        selectedEditionId = preferredEdition?.Id ?? Guid.Empty;
    }

    private void OnEditionChangedAsync()
    {
        // Nothing else to load -- the report list itself doesn't depend on data fetching.
    }

    private void ShowSuccess(string message)
    {
        successMessage = message;
        errorMessage = null;
        InvokeAsync(async () =>
        {
            await Task.Delay(3500);
            successMessage = null;
            StateHasChanged();
        });
    }

    private void ShowError(string message)
    {
        errorMessage = message;
        successMessage = null;
        InvokeAsync(async () =>
        {
            await Task.Delay(3500);
            errorMessage = null;
            StateHasChanged();
        });
    }

    private const string XlsxMimeType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
    private const string ZipMimeType = "application/zip";

    private async Task DownloadAsync(string reportType)
    {
        if (selectedEditionId == Guid.Empty)
        {
            return;
        }

        downloadingReport = reportType;

        try
        {
            byte[] bytes = await ReportApiClient.GetReportXlsxAsync(reportType, selectedEditionId);
            string base64 = Convert.ToBase64String(bytes);
            await JsRuntime.InvokeVoidAsync("downloadFileFromBase64", $"{reportType}.xlsx", base64, XlsxMimeType);
            ShowSuccess($"{Capitalize(reportType)} report downloaded successfully.");
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            downloadingReport = null;
        }
    }

    private static string Capitalize(string value)
    {
        return string.IsNullOrEmpty(value) ? value : char.ToUpperInvariant(value[0]) + value[1..];
    }

    private async Task DownloadInvoicesZipAsync()
    {
        if (selectedEditionId == Guid.Empty)
        {
            return;
        }

        downloadingReport = "invoice-pdfs";

        try
        {
            byte[] bytes = await InvoiceApiClient.GetInvoicesZipAsync(selectedEditionId);
            string base64 = Convert.ToBase64String(bytes);
            await JsRuntime.InvokeVoidAsync("downloadFileFromBase64", "invoices.zip", base64, ZipMimeType);
            ShowSuccess("Invoices downloaded successfully.");
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            downloadingReport = null;
        }
    }

    private void OpenBulkCreateInvoicesModal()
    {
        if (selectedEditionId == Guid.Empty)
        {
            return;
        }

        showBulkCreateInvoicesModal = true;
    }

    private void CloseBulkCreateInvoicesModal()
    {
        showBulkCreateInvoicesModal = false;
    }

    private async Task ConfirmBulkCreateInvoicesAsync()
    {
        showBulkCreateInvoicesModal = false;
        downloadingReport = "invoice-pdfs-generate";

        try
        {
            byte[] bytes = await InvoiceApiClient.BulkCreateInvoicesZipAsync(selectedEditionId);
            string base64 = Convert.ToBase64String(bytes);
            await JsRuntime.InvokeVoidAsync("downloadFileFromBase64", "invoices.zip", base64, ZipMimeType);
            ShowSuccess("Invoices generated and downloaded successfully.");
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            downloadingReport = null;
        }
    }
    private void HandleFestivalStateChanged()
    {
        InvokeAsync(async () =>
        {
            if (ActiveFestivalState.Active is not null)
            {
                selectedFestivalId = ActiveFestivalState.Active.Id;
                OnFestivalChangedAsync();
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ActiveFestivalState.OnChange -= HandleFestivalStateChanged;
    }
}