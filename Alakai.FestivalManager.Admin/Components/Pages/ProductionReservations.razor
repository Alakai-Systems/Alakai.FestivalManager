@page "/production-reservations"

@inject ProductionReservationApiClient ProductionReservationApiClient
@inject ProductionBuildingApiClient ProductionBuildingApiClient
@inject ProductionZoneApiClient ProductionZoneApiClient
@inject ProductionAccommodationApiClient ProductionAccommodationApiClient
@inject ProductionPersonApiClient ProductionPersonApiClient
@inject EditionApiClient EditionApiClient
@inject FestivalApiClient FestivalApiClient
@inject ActiveFestivalState ActiveFestivalState
@implements IDisposable

<PageHeader Title="Production" pTitle="Accommodation Reservations"></PageHeader>

<div class="grid grid-cols-1 gap-4 min-h-[calc(100vh-212px)]">
    <div class="card">
        <div class="flex flex-col gap-4 mb-5 xl:flex-row xl:items-center xl:justify-between">

            <div class="flex flex-col gap-3 md:flex-row md:items-center">
                <input class="form-input w-full md:w-72" placeholder="Search person, building, zone, room..." @bind="searchText" @bind:event="oninput" @bind:after="ResetPage" />

                <select class="form-select w-full md:w-44" @bind="festivalFilter" @bind:after="OnFestivalFilterChanged">
                    <option value="">All festivals</option>
                    @foreach (FestivalDto f in festivals)
                    {
                        <option value="@f.Id">@f.Name</option>
                    }
                </select>

                <select class="form-select w-full md:w-44" @bind="editionFilter" @bind:after="OnEditionFilterChanged">
                    <option value="">All editions</option>
                    @foreach (EditionDto edition in EditionsForSelectedFestival)
                    {
                        <option value="@edition.Id">@($"{edition.Year} - {edition.Name}")</option>
                    }
                </select>

                <select class="form-select w-full md:w-44" @bind="buildingFilter" @bind:after="ResetPage">
                    <option value="">All buildings</option>
                    @foreach (ProductionAccommodationBuildingDto b in BuildingsForSelectedEdition)
                    {
                        <option value="@b.Id">@b.Name</option>
                    }
                </select>

                <select class="form-select w-full md:w-32" @bind="pageSize" @bind:after="ResetPage">
                    <option value="10">10 rows</option>
                    <option value="25">25 rows</option>
                    <option value="50">50 rows</option>
                </select>

                <button type="button" class="transition-all duration-300 border rounded-md btn text-purple border-purple hover:bg-purple hover:text-white whitespace-nowrap" @onclick="OpenCreateModal">
                    <i class="ri-add-line ltr:mr-1 rtl:ml-1"></i>
                    New Reservation
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="p-3 mb-4 text-sm rounded bg-success/10 text-success">@successMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="p-3 mb-4 text-sm rounded bg-danger/10 text-danger">@errorMessage</div>
        }

        @if (isLoading)
        {
            <p class="text-sm text-black/50 dark:text-white/60">Loading reservations...</p>
        }
        else
        {
            <div class="w-full max-w-full overflow-x-auto">
                <table class="w-full table-hover">
                    <thead class="bg-gray-50 dark:bg-dark">
                        <tr class="text-left">
                            <th class="px-4 py-3 font-semibold"><button type="button" class="flex items-center gap-1 w-full font-semibold" @onclick='() => SortBy("Person")'>Person @SortIcon("Person")</button></th>
                            <th class="px-4 py-3 font-semibold">Category</th>
                            <th class="px-4 py-3 font-semibold"><button type="button" class="flex items-center gap-1 w-full font-semibold" @onclick='() => SortBy("Building")'>Building @SortIcon("Building")</button></th>
                            <th class="px-4 py-3 font-semibold"><button type="button" class="flex items-center gap-1 w-full font-semibold" @onclick='() => SortBy("Zone")'>Zone @SortIcon("Zone")</button></th>
                            <th class="px-4 py-3 font-semibold"><button type="button" class="flex items-center gap-1 w-full font-semibold" @onclick='() => SortBy("Room")'>Room @SortIcon("Room")</button></th>
                            <th class="px-4 py-3 font-semibold">Room Type</th>
                            <th class="px-4 py-3 font-semibold">Shares with</th>
                            <th class="px-4 py-3 font-semibold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="text-black dark:text-white/80">
                        @if (!PagedOccupantRows.Any())
                        {
                            <tr>
                                <td colspan="8" class="px-4 py-6 text-center text-black/50 dark:text-white/60">No reservations found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (OccupantRow occ in PagedOccupantRows)
                            {
                                <tr class="border-b border-black/10 dark:border-darkborder">
                                    <td class="px-4 py-3 font-medium">@occ.PersonName</td>
                                    <td class="px-4 py-3">@occ.Category</td>
                                    <td class="px-4 py-3">@occ.BuildingName</td>
                                    <td class="px-4 py-3">@(occ.ZoneName ?? "-")</td>
                                    <td class="px-4 py-3">@(occ.RoomName ?? "-")</td>
                                    <td class="px-4 py-3">@GetRoomTypeLabel(occ.RoomType)</td>
                                    <td class="px-4 py-3">@(occ.Roommates.Count == 0 ? "-" : string.Join(", ", occ.Roommates))</td>
                                    <td class="px-4 py-3">
                                        <div class="flex items-center justify-end gap-3">
                                            <button type="button" class="text-black dark:text-white/80" title="Edit" @onclick="() => OpenEditModal(occ.SourceReservation)">
                                                <i class="ri-pencil-line text-lg"></i>
                                            </button>
                                            <button type="button" class="text-danger" title="Delete" @onclick="() => OpenDeleteModal(occ.SourceReservation)">
                                                <i class="ri-delete-bin-line text-lg"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="flex items-center justify-between mt-4">
                <p class="text-sm text-black/50 dark:text-white/60">
                    Showing @StartRow to @EndRow of @FilteredOccupantRows.Count occupants
                </p>

                <div class="flex items-center gap-2">
                    <button type="button" class="px-4 py-2 text-sm border rounded-md border-black/10 disabled:opacity-50" disabled="@(currentPage == 1)" @onclick="PreviousPage">Previous</button>
                    <span class="flex items-center justify-center w-10 h-10 text-sm rounded-md bg-purple/10 text-purple">@currentPage</span>
                    <button type="button" class="px-4 py-2 text-sm border rounded-md border-black/10 disabled:opacity-50" disabled="@(currentPage >= TotalPages)" @onclick="NextPage">Next</button>
                </div>
            </div>
        }
    </div>
</div>

@if (isModalOpen)
{
    <div class="fixed inset-0 bg-black/60 z-[999] overflow-y-auto">
        <div class="flex items-start justify-center min-h-screen px-4 py-10">
            <div class="relative w-full max-w-lg overflow-hidden bg-white border rounded-lg shadow-3xl border-black/10 dark:bg-darklight dark:border-darkborder">
                <div class="flex items-center justify-between px-5 py-3 border-b border-black/10 dark:border-darkborder">
                    <h3 class="text-lg font-semibold">@(editingReservation is null ? "New Reservation" : "Edit Reservation")</h3>
                    <button type="button" @onclick="CloseModal"><i class="ri-close-line text-2xl"></i></button>
                </div>

                <div class="max-h-[70vh] overflow-y-auto">
                    <div class="grid grid-cols-1 gap-4 p-5">
                        @if (!string.IsNullOrWhiteSpace(modalErrorMessage))
                        {
                            <div class="p-3 text-sm rounded bg-danger/10 text-danger">@modalErrorMessage</div>
                        }

                        @if (editingReservation is null)
                        {
                            <div>
                                <label class="form-label">Building</label>
                                <select class="form-select" @bind="formModel.ProductionAccommodationBuildingId" @bind:after="OnFormBuildingChanged">
                                    @foreach (ProductionAccommodationBuildingDto b in buildings)
                                    {
                                        <option value="@b.Id">@b.Name</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <div>
                                <label class="form-label">Building</label>
                                <p class="text-sm text-black dark:text-white">@editingReservation.BuildingName</p>
                            </div>
                        }

                        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                            <div>
                                <label class="form-label">Zone (optional)</label>
                                <select class="form-select" @bind="formModel.ProductionAccommodationZoneId" @bind:after="OnFormZoneChanged">
                                    <option value="@Guid.Empty">Select zone</option>
                                    @foreach (ProductionAccommodationZoneDto z in ZonesForSelectedBuilding)
                                    {
                                        <option value="@z.Id">@z.Name</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="form-label">Room / Unit (optional)</label>
                                <select class="form-select" @bind="formModel.ProductionAccommodationId">
                                    <option value="@Guid.Empty">Select room</option>
                                    @foreach (ProductionAccommodationDto u in UnitsForSelectedZone)
                                    {
                                        <option value="@u.Id">@u.Name (@u.Capacity)</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="form-label">Occupants</label>
                            <div class="flex flex-col gap-2 p-3 overflow-y-auto border rounded-md max-h-52 border-black/10 dark:border-darkborder">
                                @foreach (ProductionPersonDto person in PeopleForSelectedBuilding)
                                {
                                    <label class="inline-flex items-center gap-2 text-sm text-black dark:text-white">
                                        <input type="checkbox" checked="@formModel.SelectedPersonIds.Contains(person.Id)" @onchange="e => TogglePerson(person.Id, (bool)e.Value!)" />
                                        @person.FirstName @person.LastName (@person.Category)
                                    </label>
                                }
                            </div>
                        </div>

                        @if (formModel.SelectedPersonIds.Count == 2)
                        {
                            <div>
                                <label class="form-label">Room Type</label>
                                <select class="form-select" @bind="formModel.RoomTypeText">
                                    <option value="">Not specified</option>
                                    <option value="1">DUI (Doble uso individual)</option>
                                    <option value="2">Double Twin</option>
                                    <option value="3">Double Matrimonio</option>
                                </select>
                            </div>
                        }
                    </div>
                </div>

                <div class="flex justify-end gap-3 px-5 py-4 border-t border-black/10 dark:border-darkborder">
                    <button type="button" class="btn border border-black/10" disabled="@isSaving" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="btn border border-purple text-purple hover:bg-purple hover:text-white disabled:opacity-50" disabled="@isSaving" @onclick="SaveAsync">@(isSaving ? "Saving..." : "Save")</button>
                </div>
            </div>
        </div>
    </div>
}

@if (deleteReservation is not null)
{
    <div class="fixed inset-0 bg-black/60 z-[999] overflow-y-auto">
        <div class="flex items-start justify-center min-h-screen px-4 py-10">
            <div class="relative w-[92vw] md:w-[380px] overflow-hidden bg-white border rounded-lg shadow-3xl border-black/10 dark:bg-darklight dark:border-darkborder">
                <div class="px-5 py-4">
                    <h3 class="text-lg font-semibold text-black dark:text-white">Delete Reservation</h3>
                    <p class="mt-2 text-sm text-black/60 dark:text-white/60">Are you sure you want to delete the reservation for <strong>@deleteReservation.BuildingName</strong>? This removes all @deleteReservation.Occupants.Count occupant(s) from it.</p>
                </div>
                <div class="flex justify-end gap-3 px-5 py-4 border-t border-black/10 dark:border-darkborder">
                    <button type="button" class="btn border border-black/10" disabled="@isSaving" @onclick="CloseDeleteModal">Cancel</button>
                    <button type="button" class="btn border border-danger text-danger hover:bg-danger hover:text-white disabled:opacity-50" disabled="@isSaving" @onclick="DeleteAsync">@(isSaving ? "Deleting..." : "Delete")</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ReservationDto> reservations = [];
    private List<ProductionAccommodationBuildingDto> buildings = [];
    private List<ProductionAccommodationZoneDto> zones = [];
    private List<ProductionAccommodationDto> rooms = [];
    private List<ProductionPersonDto> people = [];
    private List<EditionDto> editions = [];
    private List<FestivalDto> festivals = [];
    private ReservationFormModel formModel = new();
    private ReservationDto? editingReservation;
    private ReservationDto? deleteReservation;
    private string searchText = string.Empty;
    private string festivalFilter = string.Empty;
    private string editionFilter = string.Empty;
    private string buildingFilter = string.Empty;
    private string sortColumn = "Person";
    private bool sortAscending = true;
    private bool isLoading = true;
    private bool isModalOpen;
    private bool isSaving;
    private string? successMessage;
    private string? errorMessage;
    private string? modalErrorMessage;
    private int pageSize = 10;
    private int currentPage = 1;

    private List<EditionDto> EditionsForSelectedFestival =>
        string.IsNullOrWhiteSpace(festivalFilter) || !Guid.TryParse(festivalFilter, out Guid fid)
            ? editions
            : editions.Where(e => e.FestivalId == fid).ToList();

    private List<ProductionAccommodationBuildingDto> BuildingsForSelectedEdition =>
        string.IsNullOrWhiteSpace(editionFilter) || !Guid.TryParse(editionFilter, out Guid eid)
            ? buildings
            : buildings.Where(b => b.EditionId == eid).ToList();

    private List<ProductionPersonDto> PeopleForSelectedBuilding
    {
        get
        {
            ProductionAccommodationBuildingDto? building = buildings.FirstOrDefault(b => b.Id == formModel.ProductionAccommodationBuildingId);
            return building is null ? [] : people.Where(p => p.EditionId == building.EditionId).OrderBy(p => p.LastName).ToList();
        }
    }

    private List<ProductionAccommodationZoneDto> ZonesForSelectedBuilding =>
        zones.Where(z => z.ProductionAccommodationBuildingId == formModel.ProductionAccommodationBuildingId).OrderBy(z => z.SortOrder).ToList();

    private List<ProductionAccommodationDto> UnitsForSelectedZone =>
        rooms.Where(r => r.ProductionAccommodationZoneId == formModel.ProductionAccommodationZoneId).OrderBy(r => r.SortOrder).ToList();

    protected override async Task OnInitializedAsync()
    {
        ActiveFestivalState.OnChange += HandleFestivalStateChanged;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            editions = (await EditionApiClient.GetAllAsync()).ToList();
            festivals = (await FestivalApiClient.GetAllAsync()).ToList();
            buildings = (await ProductionBuildingApiClient.GetAllAsync()).ToList();
            zones = (await ProductionZoneApiClient.GetAllAsync()).ToList();
            rooms = (await ProductionAccommodationApiClient.GetAllAsync()).ToList();
            people = (await ProductionPersonApiClient.GetAllAsync()).ToList();

            if (ActiveFestivalState.Active is not null && string.IsNullOrWhiteSpace(festivalFilter))
            {
                festivalFilter = ActiveFestivalState.Active.Id.ToString();
            }

            if (ActiveFestivalState.Active is not null && string.IsNullOrWhiteSpace(editionFilter))
            {
                EditionDto? preferred = editions.FirstOrDefault(e => e.FestivalId == ActiveFestivalState.Active.Id && e.IsActive)
                    ?? editions.FirstOrDefault(e => e.FestivalId == ActiveFestivalState.Active.Id);

                if (preferred is not null)
                {
                    editionFilter = preferred.Id.ToString();
                }
            }

            reservations = (await ProductionReservationApiClient.GetAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnFestivalFilterChanged()
    {
        editionFilter = string.Empty;
        buildingFilter = string.Empty;
        ResetPage();
    }

    private void OnEditionFilterChanged()
    {
        buildingFilter = string.Empty;
        ResetPage();
    }

    private class OccupantRow
    {
        public ReservationDto SourceReservation { get; set; } = default!;
        public Guid OccupantId { get; set; }
        public Guid ProductionPersonId { get; set; }
        public string PersonName { get; set; } = "-";
        public string Category { get; set; } = "-";
        public string BuildingName { get; set; } = "-";
        public string? ZoneName { get; set; }
        public string? RoomName { get; set; }
        public int? RoomType { get; set; }
        public List<string> Roommates { get; set; } = [];
    }

    private List<OccupantRow> AllOccupantRows =>
        reservations.SelectMany(r => r.Occupants.Select(o => new OccupantRow
        {
            SourceReservation = r,
            OccupantId = o.Id,
            ProductionPersonId = o.ProductionPersonId,
            PersonName = o.ProductionPersonName ?? "-",
            Category = people.FirstOrDefault(p => p.Id == o.ProductionPersonId)?.Category.ToString() ?? "-",
            BuildingName = r.BuildingName ?? "-",
            ZoneName = o.ZoneName,
            RoomName = o.AccommodationName,
            RoomType = r.RoomType,
            Roommates = r.Occupants.Where(x => x.Id != o.Id).Select(x => x.ProductionPersonName ?? "-").ToList()
        })).ToList();

    private List<OccupantRow> FilteredOccupantRows
    {
        get
        {
            IEnumerable<OccupantRow> query = AllOccupantRows;

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                query = query.Where(o =>
                    o.PersonName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    o.BuildingName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    (o.ZoneName ?? string.Empty).Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    (o.RoomName ?? string.Empty).Contains(searchText, StringComparison.OrdinalIgnoreCase));
            }

            if (Guid.TryParse(buildingFilter, out Guid buildingId))
            {
                query = query.Where(o => o.SourceReservation.ProductionAccommodationBuildingId == buildingId);
            }
            else if (Guid.TryParse(editionFilter, out Guid editionId))
            {
                HashSet<Guid> buildingIds = buildings.Where(b => b.EditionId == editionId).Select(b => b.Id).ToHashSet();
                query = query.Where(o => buildingIds.Contains(o.SourceReservation.ProductionAccommodationBuildingId));
            }
            else if (Guid.TryParse(festivalFilter, out Guid fid))
            {
                HashSet<Guid> editionIds = editions.Where(e => e.FestivalId == fid).Select(e => e.Id).ToHashSet();
                HashSet<Guid> buildingIds = buildings.Where(b => editionIds.Contains(b.EditionId)).Select(b => b.Id).ToHashSet();
                query = query.Where(o => buildingIds.Contains(o.SourceReservation.ProductionAccommodationBuildingId));
            }

            query = sortColumn switch
            {
                "Building" => sortAscending ? query.OrderBy(o => o.BuildingName) : query.OrderByDescending(o => o.BuildingName),
                "Zone" => sortAscending ? query.OrderBy(o => o.ZoneName) : query.OrderByDescending(o => o.ZoneName),
                "Room" => sortAscending ? query.OrderBy(o => o.RoomName) : query.OrderByDescending(o => o.RoomName),
                _ => sortAscending ? query.OrderBy(o => o.PersonName) : query.OrderByDescending(o => o.PersonName)
            };

            return query.ToList();
        }
    }

    private IEnumerable<OccupantRow> PagedOccupantRows => FilteredOccupantRows.Skip((currentPage - 1) * pageSize).Take(pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredOccupantRows.Count / (double)pageSize));
    private int StartRow => FilteredOccupantRows.Count == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    private int EndRow => Math.Min(currentPage * pageSize, FilteredOccupantRows.Count);

    private void ResetPage()
    {
        currentPage = 1;
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private MarkupString SortIcon(string column)
    {
        if (sortColumn != column)
        {
            return new MarkupString("<i class=\"ri-arrow-up-down-line text-xs opacity-40\"></i>");
        }

        return new MarkupString(sortAscending ? "<i class=\"ri-arrow-up-s-fill text-xs text-purple\"></i>" : "<i class=\"ri-arrow-down-s-fill text-xs text-purple\"></i>");
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
        }
    }

    private void TogglePerson(Guid personId, bool isChecked)
    {
        if (isChecked)
        {
            formModel.SelectedPersonIds.Add(personId);
        }
        else
        {
            formModel.SelectedPersonIds.Remove(personId);
        }
    }

    private void OnFormBuildingChanged()
    {
        formModel.SelectedPersonIds.Clear();
        formModel.ProductionAccommodationZoneId = Guid.Empty;
        formModel.ProductionAccommodationId = Guid.Empty;
    }

    private void OnFormZoneChanged()
    {
        formModel.ProductionAccommodationId = Guid.Empty;
    }

    private void OpenCreateModal()
    {
        editingReservation = null;
        modalErrorMessage = null;
        ProductionAccommodationBuildingDto? defaultBuilding = buildings.FirstOrDefault(b => b.Id.ToString() == buildingFilter) ?? buildings.FirstOrDefault();
        formModel = new ReservationFormModel
        {
            ProductionAccommodationBuildingId = defaultBuilding?.Id ?? Guid.Empty
        };
        isModalOpen = true;
    }

    private void OpenEditModal(ReservationDto reservation)
    {
        editingReservation = reservation;
        modalErrorMessage = null;

        ReservationOccupantDto? withUnit = reservation.Occupants.FirstOrDefault(o => o.ProductionAccommodationId.HasValue);
        Guid zoneId = Guid.Empty;
        Guid unitId = Guid.Empty;

        if (withUnit?.ProductionAccommodationId is Guid existingUnitId)
        {
            ProductionAccommodationDto? unit = rooms.FirstOrDefault(r => r.Id == existingUnitId);

            if (unit is not null)
            {
                unitId = unit.Id;
                zoneId = unit.ProductionAccommodationZoneId;
            }
        }

        formModel = new ReservationFormModel
        {
            ProductionAccommodationBuildingId = reservation.ProductionAccommodationBuildingId,
            ProductionAccommodationZoneId = zoneId,
            ProductionAccommodationId = unitId,
            SelectedPersonIds = reservation.Occupants.Select(o => o.ProductionPersonId).ToHashSet(),
            RoomTypeText = reservation.RoomType?.ToString() ?? string.Empty
        };
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
        isSaving = false;
    }

    private async Task SaveAsync()
    {
        if (isSaving) return;

        try
        {
            isSaving = true;
            modalErrorMessage = null;

            Guid? unitId = formModel.ProductionAccommodationId == Guid.Empty ? null : formModel.ProductionAccommodationId;
            int? roomType = int.TryParse(formModel.RoomTypeText, out int rt) ? rt : null;
            List<ReservationOccupantInput> occupants = formModel.SelectedPersonIds.Select(id => new ReservationOccupantInput
            {
                ProductionPersonId = id,
                ProductionAccommodationId = unitId
            }).ToList();

            if (editingReservation is null)
            {
                ProductionAccommodationBuildingDto? building = buildings.FirstOrDefault(b => b.Id == formModel.ProductionAccommodationBuildingId);

                if (building is null)
                {
                    modalErrorMessage = "Please select a building.";
                    return;
                }

                CreateReservationRequest request = new()
                {
                    EditionId = building.EditionId,
                    ProductionAccommodationBuildingId = formModel.ProductionAccommodationBuildingId,
                    RoomType = roomType,
                    Occupants = occupants
                };

                await ProductionReservationApiClient.CreateAsync(request);
                ShowSuccess("Reservation created successfully.");
            }
            else
            {
                UpdateReservationRequest request = new()
                {
                    RoomType = roomType,
                    Occupants = occupants
                };

                await ProductionReservationApiClient.UpdateAsync(editingReservation.Id, request);
                ShowSuccess("Reservation updated successfully.");
            }

            CloseModal();
            await LoadDataAsync();
        }
        catch (ApiClientException ex)
        {
            modalErrorMessage = BuildErrorMessage(ex);
        }
        catch (Exception ex)
        {
            modalErrorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OpenDeleteModal(ReservationDto reservation)
    {
        deleteReservation = reservation;
    }

    private void CloseDeleteModal()
    {
        deleteReservation = null;
    }

    private async Task DeleteAsync()
    {
        if (deleteReservation is null || isSaving) return;

        try
        {
            isSaving = true;
            await ProductionReservationApiClient.DeleteAsync(deleteReservation.Id);
            deleteReservation = null;
            ShowSuccess("Reservation deleted successfully.");
            await LoadDataAsync();
        }
        catch (ApiClientException ex)
        {
            errorMessage = BuildErrorMessage(ex);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string BuildErrorMessage(ApiClientException exception)
    {
        if (exception.Errors.Count == 0)
        {
            return exception.Message;
        }

        return $"{exception.Message} {string.Join(" ", exception.Errors)}";
    }

    private static string GetRoomTypeLabel(int? roomType) => roomType switch
    {
        1 => "DUI",
        2 => "Double Twin",
        3 => "Double Matrimonio",
        _ => "-"
    };

    private void ShowSuccess(string message)
    {
        successMessage = message;
        errorMessage = null;
        InvokeAsync(async () =>
        {
            await Task.Delay(3500);
            successMessage = null;
            StateHasChanged();
        });
    }

    private void ShowError(string message)
    {
        errorMessage = message;
        successMessage = null;
        InvokeAsync(async () =>
        {
            await Task.Delay(3500);
            errorMessage = null;
            StateHasChanged();
        });
    }

    private class ReservationFormModel
    {
        public Guid ProductionAccommodationBuildingId { get; set; }
        public Guid ProductionAccommodationZoneId { get; set; }
        public Guid ProductionAccommodationId { get; set; }
        public HashSet<Guid> SelectedPersonIds { get; set; } = [];
        public string RoomTypeText { get; set; } = string.Empty;
    }

    private void HandleFestivalStateChanged()
    {
        InvokeAsync(async () =>
        {
            festivalFilter = string.Empty;
            editionFilter = string.Empty;
            buildingFilter = string.Empty;
            await LoadDataAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ActiveFestivalState.OnChange -= HandleFestivalStateChanged;
    }
}
